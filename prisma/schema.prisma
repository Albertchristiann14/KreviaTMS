generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// 1. CANONICAL ENUMS (6 Canonical + 15 Supporting = 21 PostgreSQL ENUMs)
// ============================================================================

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  REVISION
  DONE
  CANCELLED

  @@map("task_status_enum")
}

enum TaskType {
  GENERAL
  CONTENT_PRODUCTION
  DESIGN_TASK

  @@map("task_type_enum")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority_enum")
}

enum ContentStatus {
  IDEA
  APPROVED_IDEA
  PLANNING
  IN_DESIGN
  DESIGN_REVIEW
  DESIGN_REVISION
  READY_TO_PUBLISH
  SCHEDULED
  PUBLISHED
  ARCHIVED

  @@map("content_status_enum")
}

enum DesignSubmissionStatus {
  PENDING_BRIEF
  IN_PROGRESS
  SUBMITTED
  REVISION_REQUESTED
  APPROVED

  @@map("design_submission_status_enum")
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  FINALIZED

  @@map("kpi_evaluation_status_enum")
}

enum EmploymentStatus {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  INACTIVE

  @@map("employment_status_enum")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED

  @@map("project_status_enum")
}

enum ProjectMemberRole {
  OWNER
  LEAD
  MEMBER
  VIEWER

  @@map("project_member_role_enum")
}

enum ContentIdeaStatus {
  IDEA
  APPROVED_IDEA
  CONVERTED
  ARCHIVED

  @@map("content_idea_status_enum")
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  LINKEDIN
  YOUTUBE
  X_TWITTER
  FACEBOOK
  WEBSITE_BLOG

  @@map("social_platform_enum")
}

enum ContentFormat {
  REELS
  CAROUSEL
  SINGLE_POST
  STORY
  SHORT_VIDEO
  LONG_VIDEO
  ARTICLE
  INFOGRAPHIC

  @@map("content_format_enum")
}

enum DesignReviewDecision {
  APPROVED
  REVISION_REQUESTED

  @@map("design_review_decision_enum")
}

enum AssetSourceType {
  UPLOAD
  FIGMA
  CANVA
  GOOGLE_DRIVE
  OTHER_LINK

  @@map("asset_source_type_enum")
}

enum AssetCategory {
  BRAND_KIT
  SOCIAL_MEDIA
  CAMPAIGN
  TEMPLATE
  PHOTO_VIDEO
  DOCUMENT
  OTHER

  @@map("asset_category_enum")
}

enum KpiCategory {
  DELIVERY
  QUALITY
  PRODUCTIVITY
  CREATIVE
  COLLABORATION

  @@map("kpi_category_enum")
}

enum KpiMetricSource {
  AUTO_TCR
  AUTO_OTDR
  AUTO_DQS
  AUTO_CPVS
  MANUAL_SCORE

  @@map("kpi_metric_source_enum")
}

enum KpiUnit {
  PERCENTAGE
  COUNT
  SCORE_100
  RATIO

  @@map("kpi_unit_enum")
}

enum KpiGrade {
  A
  B
  C
  D

  @@map("kpi_grade_enum")
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_REASSIGNED
  TASK_STATUS_CHANGED
  TASK_SUBMITTED_REVIEW
  TASK_REVISION_REQUESTED
  TASK_COMPLETED
  TASK_COMMENT_MENTION
  TASK_DEADLINE_SOON
  TASK_DEADLINE_TODAY
  TASK_OVERDUE
  CONTENT_IDEA_REVIEWED
  CONTENT_READY_TO_PUBLISH
  DESIGN_BRIEF_ASSIGNED
  DESIGN_SUBMITTED
  DESIGN_REVISION_REQUESTED
  DESIGN_APPROVED
  KPI_EVALUATION_OPEN
  KPI_EVALUATION_SUBMITTED
  KPI_EVALUATION_FINALIZED
  ANNOUNCEMENT_PUBLISHED
  SYSTEM_ALERT

  @@map("notification_type_enum")
}

enum AnnouncementPriority {
  INFO
  IMPORTANT
  URGENT

  @@map("announcement_priority_enum")
}

// ============================================================================
// 2. IDENTITY, TEAM DIRECTORY & RBAC (4 Tables)
// ============================================================================

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users           User[]
  rolePermissions RolePermission[]
  kpiTemplates    KpiTemplate[]

  @@map("roles")
}

model User {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId             String           @map("role_id") @db.Uuid
  managerId          String?          @map("manager_id") @db.Uuid
  email              String           @unique @db.VarChar(255)
  passwordHash       String           @map("password_hash") @db.Text
  fullName           String           @map("full_name") @db.VarChar(150)
  displayName        String?          @map("display_name") @db.VarChar(80)
  avatarUrl          String?          @map("avatar_url") @db.Text
  jobTitle           String           @map("job_title") @db.VarChar(100)
  department         String           @default("Operations") @db.VarChar(100)
  phone              String?          @db.VarChar(30)
  bio                String?          @db.Text
  skills             String[]         @default([]) @db.Text
  employmentStatus   EmploymentStatus @default(FULL_TIME) @map("employment_status")
  joinedAt           DateTime?        @map("joined_at") @db.Date
  isActive           Boolean          @default(true) @map("is_active")
  mustChangePassword Boolean          @default(false) @map("must_change_password")
  tokenVersion       Int              @default(1) @map("token_version")
  lastLoginAt        DateTime?        @map("last_login_at") @db.Timestamptz
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?        @map("deleted_at") @db.Timestamptz

  role                  Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  manager               User?               @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates          User[]              @relation("UserManager")
  grantedPermissions    RolePermission[]    @relation("PermissionGranter")
  ownedProjects         Project[]           @relation("ProjectOwner")
  projectMemberships    ProjectMember[]     @relation("ProjectMemberUser")
  addedProjectMembers   ProjectMember[]     @relation("ProjectMemberAddedBy")
  proposedContentIdeas  ContentIdea[]       @relation("IdeaProposer")
  reviewedContentIdeas  ContentIdea[]       @relation("IdeaReviewer")
  createdContentItems   ContentItem[]       @relation("ContentCreator")
  approvedContentItems  ContentItem[]       @relation("ContentApprover")
  requestedDesignBriefs DesignBrief[]       @relation("BriefRequester")
  assignedDesignBriefs  DesignBrief[]       @relation("BriefDesigner")
  approvedDesignBriefs  DesignBrief[]       @relation("BriefApprover")
  designSubmissions     DesignSubmission[]  @relation("DesignSubmitter")
  designReviews         DesignReview[]      @relation("DesignReviewer")
  uploadedAssets        Asset[]             @relation("AssetUploader")
  recordedAnalytics     ContentAnalytic[]   @relation("AnalyticsRecorder")
  assignedTasks         Task[]              @relation("TaskAssignee")
  reportedTasks         Task[]              @relation("TaskReporter")
  reviewedTasks         Task[]              @relation("TaskReviewer")
  completedChecklists   TaskChecklist[]     @relation("ChecklistCompleter")
  taskComments          TaskComment[]       @relation("CommentAuthor")
  taskAttachments       TaskAttachment[]    @relation("AttachmentUploader")
  createdKpiTemplates   KpiTemplate[]       @relation("KpiTemplateCreator")
  kpiAssignments        KpiAssignment[]     @relation("KpiAssignmentUser")
  assignedKpis          KpiAssignment[]     @relation("KpiAssignmentAssigner")
  evaluationsReceived   MonthlyEvaluation[] @relation("EvaluationEmployee")
  evaluationsGiven      MonthlyEvaluation[] @relation("EvaluationEvaluator")
  evaluationsFinalized  MonthlyEvaluation[] @relation("EvaluationFinalizer")
  notificationsReceived Notification[]      @relation("NotificationRecipient")
  notificationsActed    Notification[]      @relation("NotificationActor")
  announcements         Announcement[]      @relation("AnnouncementAuthor")
  announcementReads     AnnouncementRead[]
  activityLogs          ActivityLog[]       @relation("ActivityActor")

  @@map("users")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(100)
  module      String   @db.VarChar(50)
  resource    String   @db.VarChar(50)
  action      String   @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedBy    String?  @map("granted_by") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granter    User?      @relation("PermissionGranter", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================================
// 3. PROJECTS & MEMBERSHIP — MODUL A (2 Tables)
// ============================================================================

model Project {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String        @unique @db.VarChar(20)
  name          String        @db.VarChar(150)
  description   String?       @db.Text
  status        ProjectStatus @default(ACTIVE)
  colorHex      String        @default("#2563EB") @map("color_hex") @db.VarChar(7)
  ownerId       String        @map("owner_id") @db.Uuid
  startDate     DateTime?     @map("start_date") @db.Date
  targetEndDate DateTime?     @map("target_end_date") @db.Date
  archivedAt    DateTime?     @map("archived_at") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz

  owner        User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members      ProjectMember[]
  contentIdeas ContentIdea[]
  contentItems ContentItem[]
  designBriefs DesignBrief[]
  assets       Asset[]
  tasks        Task[]

  @@map("projects")
}

model ProjectMember {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String            @map("project_id") @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  projectRole ProjectMemberRole @default(MEMBER) @map("project_role")
  addedBy     String?           @map("added_by") @db.Uuid
  joinedAt    DateTime          @default(now()) @map("joined_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  adder   User?   @relation("ProjectMemberAddedBy", fields: [addedBy], references: [id], onDelete: SetNull)

  @@unique([projectId, userId], map: "uq_project_members_pair")
  @@map("project_members")
}

// ============================================================================
// 4. SOCIAL MEDIA & DESIGN MANAGEMENT — MODUL C (7 Tables)
// ============================================================================

model ContentIdea {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String            @map("project_id") @db.Uuid
  title            String            @db.VarChar(200)
  description      String?           @db.Text
  targetPlatform   SocialPlatform    @default(INSTAGRAM) @map("target_platform")
  contentPillar    String?           @map("content_pillar") @db.VarChar(100)
  referenceUrls    Json              @default("[]") @map("reference_urls")
  status           ContentIdeaStatus @default(IDEA)
  upvotedByUserIds String[]          @default([]) @map("upvoted_by_user_ids") @db.Uuid
  proposedBy       String            @map("proposed_by") @db.Uuid
  reviewedBy       String?           @map("reviewed_by") @db.Uuid
  reviewNotes      String?           @map("review_notes") @db.Text
  reviewedAt       DateTime?         @map("reviewed_at") @db.Timestamptz
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  proposer     User          @relation("IdeaProposer", fields: [proposedBy], references: [id], onDelete: Restrict)
  reviewer     User?         @relation("IdeaReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  contentItems ContentItem[]

  @@map("content_ideas")
}

model ContentItem {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String         @map("project_id") @db.Uuid
  ideaId           String?        @map("idea_id") @db.Uuid
  title            String         @db.VarChar(200)
  platform         SocialPlatform
  contentFormat    ContentFormat  @map("content_format")
  contentPillar    String?        @map("content_pillar") @db.VarChar(100)
  campaignName     String?        @map("campaign_name") @db.VarChar(150)
  status           ContentStatus  @default(PLANNING)
  requiresDesign   Boolean        @default(true) @map("requires_design")
  caption          String?        @db.Text
  hashtags         String[]       @default([]) @db.Text
  ctaText          String?        @map("cta_text") @db.VarChar(255)
  creatorId        String         @map("creator_id") @db.Uuid
  approverId       String?        @map("approver_id") @db.Uuid
  plannedPublishAt DateTime?      @map("planned_publish_at") @db.Timestamptz
  publishedAt      DateTime?      @map("published_at") @db.Timestamptz
  publishedUrl     String?        @map("published_url") @db.Text
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  idea         ContentIdea?      @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  creator      User              @relation("ContentCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  approver     User?             @relation("ContentApprover", fields: [approverId], references: [id], onDelete: SetNull)
  designBriefs DesignBrief[]
  assets       Asset[]
  analytics    ContentAnalytic[]
  tasks        Task[]

  @@map("content_items")
}

model DesignBrief {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId            String                 @map("project_id") @db.Uuid
  contentItemId        String?                @map("content_item_id") @db.Uuid
  title                String                 @db.VarChar(200)
  objective            String                 @db.Text
  dimensionsSpec       String?                @map("dimensions_spec") @db.VarChar(150)
  copyText             String?                @map("copy_text") @db.Text
  brandGuidelinesNotes String?                @map("brand_guidelines_notes") @db.Text
  referenceLinks       Json                   @default("[]") @map("reference_links")
  status               DesignSubmissionStatus @default(PENDING_BRIEF)
  requestedBy          String                 @map("requested_by") @db.Uuid
  assignedDesignerId   String?                @map("assigned_designer_id") @db.Uuid
  dueDate              DateTime?              @map("due_date") @db.Timestamptz
  currentVersion       Int                    @default(0) @map("current_version")
  revisionCount        Int                    @default(0) @map("revision_count")
  approvedAt           DateTime?              @map("approved_at") @db.Timestamptz
  approvedBy           String?                @map("approved_by") @db.Uuid
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime?              @map("deleted_at") @db.Timestamptz

  project          Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  contentItem      ContentItem?       @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  requester        User               @relation("BriefRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  assignedDesigner User?              @relation("BriefDesigner", fields: [assignedDesignerId], references: [id], onDelete: SetNull)
  approver         User?              @relation("BriefApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  submissions      DesignSubmission[]
  tasks            Task[]

  @@map("design_briefs")
}

model DesignSubmission {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  designBriefId String                 @map("design_brief_id") @db.Uuid
  versionNumber Int                    @map("version_number")
  submittedBy   String                 @map("submitted_by") @db.Uuid
  status        DesignSubmissionStatus @default(SUBMITTED)
  sourceType    AssetSourceType        @default(UPLOAD) @map("source_type")
  fileUrl       String                 @map("file_url") @db.Text
  storageKey    String?                @map("storage_key") @db.Text
  thumbnailUrl  String?                @map("thumbnail_url") @db.Text
  mimeType      String?                @map("mime_type") @db.VarChar(120)
  fileSizeBytes BigInt?                @map("file_size_bytes")
  designerNotes String?                @map("designer_notes") @db.Text
  submittedAt   DateTime               @default(now()) @map("submitted_at") @db.Timestamptz
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz

  designBrief DesignBrief    @relation(fields: [designBriefId], references: [id], onDelete: Cascade)
  submitter   User           @relation("DesignSubmitter", fields: [submittedBy], references: [id], onDelete: Restrict)
  reviews     DesignReview[]
  assets      Asset[]

  @@unique([designBriefId, versionNumber], map: "uq_design_submissions_ver")
  @@map("design_submissions")
}

model DesignReview {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  designSubmissionId String               @map("design_submission_id") @db.Uuid
  reviewerId         String               @map("reviewer_id") @db.Uuid
  decision           DesignReviewDecision
  feedback           String               @db.Text
  revisionChecklist  Json                 @default("[]") @map("revision_checklist")
  reviewedAt         DateTime             @default(now()) @map("reviewed_at") @db.Timestamptz

  designSubmission DesignSubmission @relation(fields: [designSubmissionId], references: [id], onDelete: Cascade)
  reviewer         User             @relation("DesignReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@map("design_reviews")
}

model Asset {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId            String?         @map("project_id") @db.Uuid
  contentItemId        String?         @map("content_item_id") @db.Uuid
  designSubmissionId   String?         @map("design_submission_id") @db.Uuid
  title                String          @db.VarChar(200)
  description          String?         @db.Text
  category             AssetCategory   @default(OTHER)
  sourceType           AssetSourceType @default(UPLOAD) @map("source_type")
  fileUrl              String          @map("file_url") @db.Text
  storageKey           String?         @map("storage_key") @db.Text
  thumbnailUrl         String?         @map("thumbnail_url") @db.Text
  mimeType             String?         @map("mime_type") @db.VarChar(120)
  fileSizeBytes        BigInt?         @map("file_size_bytes")
  tags                 String[]        @default([]) @db.Text
  metadata             Json            @default("{}")
  uploadedBy           String          @map("uploaded_by") @db.Uuid
  isApprovedBrandAsset Boolean         @default(false) @map("is_approved_brand_asset")
  isSuperseded         Boolean         @default(false) @map("is_superseded")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime?       @map("deleted_at") @db.Timestamptz

  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contentItem      ContentItem?      @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  designSubmission DesignSubmission? @relation(fields: [designSubmissionId], references: [id], onDelete: SetNull)
  uploader         User              @relation("AssetUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@map("assets")
}

model ContentAnalytic {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentItemId String   @map("content_item_id") @db.Uuid
  recordedDate  DateTime @map("recorded_date") @db.Date
  impressions   Int      @default(0)
  reach         Int      @default(0)
  likes         Int      @default(0)
  comments      Int      @default(0)
  shares        Int      @default(0)
  saves         Int      @default(0)
  clicks        Int      @default(0)
  videoViews    Int      @default(0) @map("video_views")
  // Stored Generated Columns in PostgreSQL (migration.sql): NEVER write in Prisma create/update!
  engagementRate Decimal @default(dbgenerated()) @map("engagement_rate") @db.Decimal(6, 2)
  ctr            Decimal @default(dbgenerated()) @map("ctr") @db.Decimal(6, 2)
  notes         String?  @db.Text
  recordedBy    String   @map("recorded_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  recorder    User        @relation("AnalyticsRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)

  @@unique([contentItemId, recordedDate], map: "uq_content_analytics_day")
  @@map("content_analytics")
}

// ============================================================================
// 5. UNIFIED TASKS & COLLABORATION — MODUL A (4 Tables)
// ============================================================================

model Task {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskCode         String       @unique @map("task_code") @db.VarChar(30)
  projectId        String?      @map("project_id") @db.Uuid
  parentTaskId     String?      @map("parent_task_id") @db.Uuid
  contentItemId    String?      @map("content_item_id") @db.Uuid
  designBriefId    String?      @map("design_brief_id") @db.Uuid
  title            String       @db.VarChar(200)
  description      String?      @db.Text
  taskType         TaskType     @default(GENERAL) @map("task_type")
  status           TaskStatus   @default(TODO)
  priority         TaskPriority @default(MEDIUM)
  position         Float        @default(65536)
  version          Int          @default(1)
  requiresReview   Boolean      @default(true) @map("requires_review")
  assigneeId       String?      @map("assignee_id") @db.Uuid
  reporterId       String       @map("reporter_id") @db.Uuid
  reviewerId       String?      @map("reviewer_id") @db.Uuid
  startDate        DateTime?    @map("start_date") @db.Date
  startedAt        DateTime?    @map("started_at") @db.Timestamptz
  firstSubmittedAt DateTime?    @map("first_submitted_at") @db.Timestamptz
  dueDate          DateTime?    @map("due_date") @db.Timestamptz
  completedAt      DateTime?    @map("completed_at") @db.Timestamptz
  isOnTime         Boolean?     @map("is_on_time")
  estimatedHours   Decimal?     @map("estimated_hours") @db.Decimal(5, 2)
  actualHours      Decimal?     @map("actual_hours") @db.Decimal(5, 2)
  revisionCount    Int          @default(0) @map("revision_count")
  tags             String[]     @default([]) @db.Text
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz

  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentTask  Task?            @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks    Task[]           @relation("TaskSubtasks")
  contentItem ContentItem?     @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  designBrief DesignBrief?     @relation(fields: [designBriefId], references: [id], onDelete: SetNull)
  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter    User             @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reviewer    User?            @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  checklists  TaskChecklist[]
  comments    TaskComment[]
  attachments TaskAttachment[]

  @@map("tasks")
}

model TaskChecklist {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId      String    @map("task_id") @db.Uuid
  title       String    @db.VarChar(255)
  isCompleted Boolean   @default(false) @map("is_completed")
  completedBy String?   @map("completed_by") @db.Uuid
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  task      Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completer User? @relation("ChecklistCompleter", fields: [completedBy], references: [id], onDelete: SetNull)

  @@map("task_checklists")
}

model TaskComment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId           String    @map("task_id") @db.Uuid
  authorId         String    @map("author_id") @db.Uuid
  parentCommentId  String?   @map("parent_comment_id") @db.Uuid
  body             String    @db.Text
  mentionedUserIds String[]  @default([]) @map("mentioned_user_ids") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  task          Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author        User          @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  parentComment TaskComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies       TaskComment[] @relation("CommentReplies")

  @@map("task_comments")
}

model TaskAttachment {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId        String          @map("task_id") @db.Uuid
  uploadedBy    String          @map("uploaded_by") @db.Uuid
  sourceType    AssetSourceType @default(UPLOAD) @map("source_type")
  fileName      String          @map("file_name") @db.VarChar(255)
  fileUrl       String          @map("file_url") @db.Text
  storageKey    String?         @map("storage_key") @db.Text
  mimeType      String?         @map("mime_type") @db.VarChar(120)
  fileSizeBytes BigInt?         @map("file_size_bytes")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  deletedAt     DateTime?       @map("deleted_at") @db.Timestamptz

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader User @relation("AttachmentUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@map("task_attachments")
}

// ============================================================================
// 6. TEAM MANAGEMENT & KPI EVALUATION — MODUL B (4 Tables)
// ============================================================================

model KpiTemplate {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String          @unique @db.VarChar(50)
  name               String          @db.VarChar(150)
  description        String?         @db.Text
  category           KpiCategory
  applicableRoleId   String?         @map("applicable_role_id") @db.Uuid
  metricSource       KpiMetricSource @map("metric_source")
  unit               KpiUnit         @default(PERCENTAGE)
  defaultTargetValue Decimal         @map("default_target_value") @db.Decimal(10, 2)
  defaultWeight      Decimal         @map("default_weight") @db.Decimal(5, 2)
  isHigherBetter     Boolean         @default(true) @map("is_higher_better")
  isActive           Boolean         @default(true) @map("is_active")
  createdBy          String          @map("created_by") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz

  applicableRole  Role?            @relation(fields: [applicableRoleId], references: [id], onDelete: SetNull)
  creator         User             @relation("KpiTemplateCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  kpiAssignments  KpiAssignment[]
  evaluationItems EvaluationItem[]

  @@map("kpi_templates")
}

model KpiAssignment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  kpiTemplateId String   @map("kpi_template_id") @db.Uuid
  periodYear    Int      @map("period_year") @db.SmallInt
  periodMonth   Int      @map("period_month") @db.SmallInt
  targetValue   Decimal  @map("target_value") @db.Decimal(10, 2)
  weight        Decimal  @db.Decimal(5, 2)
  assignedBy    String   @map("assigned_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user            User             @relation("KpiAssignmentUser", fields: [userId], references: [id], onDelete: Restrict)
  kpiTemplate     KpiTemplate      @relation(fields: [kpiTemplateId], references: [id], onDelete: Restrict)
  assigner        User             @relation("KpiAssignmentAssigner", fields: [assignedBy], references: [id], onDelete: Restrict)
  evaluationItems EvaluationItem[]

  @@unique([userId, kpiTemplateId, periodYear, periodMonth], map: "uq_kpi_assignments_period")
  @@map("kpi_assignments")
}

model MonthlyEvaluation {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String           @map("user_id") @db.Uuid
  evaluatorId          String           @map("evaluator_id") @db.Uuid
  periodYear           Int              @map("period_year") @db.SmallInt
  periodMonth          Int              @map("period_month") @db.SmallInt
  status               EvaluationStatus @default(DRAFT)
  totalTasksAssigned   Int              @default(0) @map("total_tasks_assigned")
  totalTasksCompleted  Int              @default(0) @map("total_tasks_completed")
  tasksCompletedOnTime Int              @default(0) @map("tasks_completed_on_time")
  completionRate       Decimal?         @map("completion_rate") @db.Decimal(5, 2)
  onTimeRate           Decimal?         @map("on_time_rate") @db.Decimal(5, 2)
  avgRevisionCount     Decimal?         @map("avg_revision_count") @db.Decimal(5, 2)
  designQualityScore   Decimal?         @map("design_quality_score") @db.Decimal(5, 2)
  weightedKpiScore     Decimal          @default(0.00) @map("weighted_kpi_score") @db.Decimal(5, 2)
  performanceGrade     KpiGrade?        @map("performance_grade")
  autoMetricsSnapshot  Json             @default("{}") @map("auto_metrics_snapshot")
  selfAssessmentNotes  String?          @map("self_assessment_notes") @db.Text
  evaluatorNotes       String?          @map("evaluator_notes") @db.Text
  submittedAt          DateTime?        @map("submitted_at") @db.Timestamptz
  reviewedAt           DateTime?        @map("reviewed_at") @db.Timestamptz
  finalizedAt          DateTime?        @map("finalized_at") @db.Timestamptz
  finalizedBy          String?          @map("finalized_by") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user      User             @relation("EvaluationEmployee", fields: [userId], references: [id], onDelete: Restrict)
  evaluator User             @relation("EvaluationEvaluator", fields: [evaluatorId], references: [id], onDelete: Restrict)
  finalizer User?            @relation("EvaluationFinalizer", fields: [finalizedBy], references: [id], onDelete: SetNull)
  items     EvaluationItem[]

  @@unique([userId, periodYear, periodMonth], map: "uq_monthly_eval_user_period")
  @@map("monthly_evaluations")
}

model EvaluationItem {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  monthlyEvaluationId   String          @map("monthly_evaluation_id") @db.Uuid
  kpiAssignmentId       String?         @map("kpi_assignment_id") @db.Uuid
  kpiTemplateId         String          @map("kpi_template_id") @db.Uuid
  indicatorNameSnapshot String          @map("indicator_name_snapshot") @db.VarChar(150)
  metricSource          KpiMetricSource @map("metric_source")
  targetValue           Decimal         @map("target_value") @db.Decimal(10, 2)
  actualValue           Decimal?        @map("actual_value") @db.Decimal(10, 2)
  weight                Decimal         @db.Decimal(5, 2)
  achievementPct        Decimal?        @map("achievement_pct") @db.Decimal(6, 2)
  weightedScore         Decimal?        @map("weighted_score") @db.Decimal(6, 2)
  evidenceNotes         String?         @map("evidence_notes") @db.Text
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  monthlyEvaluation MonthlyEvaluation @relation(fields: [monthlyEvaluationId], references: [id], onDelete: Cascade)
  kpiAssignment     KpiAssignment?    @relation(fields: [kpiAssignmentId], references: [id], onDelete: SetNull)
  kpiTemplate       KpiTemplate       @relation(fields: [kpiTemplateId], references: [id], onDelete: Restrict)

  @@unique([monthlyEvaluationId, kpiTemplateId], map: "uq_eval_items_template")
  @@map("evaluation_items")
}

// ============================================================================
// 7. SYSTEM MANAGEMENT: NOTIFICATIONS, ANNOUNCEMENTS & AUDIT LOGS — MODUL D (4 Tables)
// ============================================================================

model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  actorId     String?          @map("actor_id") @db.Uuid
  type        NotificationType
  title       String           @db.VarChar(180)
  message     String           @db.Text
  entityType  String?          @map("entity_type") @db.VarChar(50)
  entityId    String?          @map("entity_id") @db.Uuid
  actionUrl   String?          @map("action_url") @db.VarChar(255)
  isRead      Boolean          @default(false) @map("is_read")
  readAt      DateTime?        @map("read_at") @db.Timestamptz
  metadata    Json             @default("{}")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model Announcement {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId      String               @map("author_id") @db.Uuid
  title         String               @db.VarChar(200)
  content       String               @db.Text
  priority      AnnouncementPriority @default(INFO)
  targetRoleIds String[]             @default([]) @map("target_role_ids") @db.Uuid
  isPinned      Boolean              @default(false) @map("is_pinned")
  publishedAt   DateTime             @default(now()) @map("published_at") @db.Timestamptz
  expiresAt     DateTime?            @map("expires_at") @db.Timestamptz
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?            @map("deleted_at") @db.Timestamptz

  author User               @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reads  AnnouncementRead[]

  @@map("announcements")
}

model AnnouncementRead {
  announcementId String   @map("announcement_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@map("announcement_reads")
}

model ActivityLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(80)
  module     String   @db.VarChar(50)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.Uuid
  summary    String   @db.VarChar(255)
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}
